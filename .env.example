# Exemplo de configuracao do Painel de Cogestao.
# Copie este arquivo para .env e preencha os valores. O .env nao e versionado.
# Todas as variaveis sao opcionais: sem elas o painel roda com os dados de exemplo.

# Frase-senha que protege o acesso ao painel (login simples do lado do cliente).
# Troque por uma frase propria da sua gestao. Valor padrao usado quando vazio: presidencia2024
VITE_APP_PASSPHRASE=presidencia2024

# ID da planilha do Google Sheets usada como fonte de dados (opcional).
# Fica na URL da planilha: https://docs.google.com/spreadsheets/d/SEU_ID_AQUI/edit
# Deixe vazio para usar os dados de exemplo empacotados no painel.
VITE_SHEET_ID=

# Nome das abas da planilha correspondentes a cada secao do painel.
# Ajuste apenas se as suas abas tiverem nomes diferentes dos padroes abaixo.
VITE_TAB_VISAO_GERAL=Visao Geral
VITE_TAB_CREDENCIAIS=Credenciais
VITE_TAB_LINKS=Links
VITE_TAB_MANUAIS=Manuais
VITE_TAB_DEMANDAS=Demandas
VITE_TAB_CALENDARIO=Calendario
VITE_TAB_CONTATOS=Contatos
